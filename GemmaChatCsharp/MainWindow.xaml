<Window x:Class="GemmaChatWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:GemmaChatWindows.ViewModels"
        xmlns:converters="clr-namespace:GemmaChatWindows.Converters"
        xmlns:markdig="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="Gemma Local Desktop" Height="750" Width="1050" 
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Inter, sans-serif" FontSize="14">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="8" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewChatCommand}"/>
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding ToggleModeCommand}"/>
        <KeyBinding Key="Oem5" Modifiers="Control" Command="{Binding ToggleCanvasCommand}"/>
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportProjectCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsEnabled}">
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="Rectangle1" Background="#22FFFFFF" CornerRadius="4" Margin="2,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="true">
                                                        <Setter TargetName="Rectangle1" Property="Background" Value="#44FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Background="#050505" BorderBrush="#11FFFFFF" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <!-- ================= SETUP SCREEN ================= -->
        <Grid Visibility="{Binding IsSetupVisible, Converter={StaticResource BooleanToVisibilityConverter}}" WindowChrome.IsHitTestVisibleInChrome="True">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500">
                
                <Image Source="Assets/gemma-logo.png" Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Welcome to Gemma Local Desktop" Foreground="White" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                
                <TextBlock Text="A local multimodal AI assistant, powered by Google's Gemma 4 via llama.cpp." 
                           Foreground="#888888" FontSize="13.5" HorizontalAlignment="Center" Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                <TextBlock Text="Runs 100% on your PC. Text, Image, and Audio supported." 
                           Foreground="#888888" FontSize="13.5" HorizontalAlignment="Center" Margin="0,4,0,32" TextWrapping="Wrap" TextAlignment="Center"/>

                <TextBlock Text="CHOOSE A MODEL TO START" Foreground="#888888" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,8"/>

                <!-- Models ListBox -->
                <ListBox ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding SelectedModel}" 
                         Background="Transparent" BorderThickness="0" Foreground="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" CornerRadius="12" BorderThickness="1" BorderBrush="#1AFFFFFF" Background="#05FFFFFF" Margin="0,0,0,8" Padding="16">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#0DFFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <!-- The gold/yellow border from the screenshot -->
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#EAB308"/>
                                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="SemiBold" FontSize="14.5"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Size}" Foreground="#888" FontSize="11" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="{Binding Description}" Foreground="#888" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Start Button -->
                <Border Background="White" CornerRadius="12" Margin="0,16,0,0" Cursor="Hand" Padding="0,12">
                    <Border.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding StartSetupCommand}" />
                    </Border.InputBindings>
                    <TextBlock Text="Start" Foreground="#0A0A0A" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </Border>

                <StackPanel Margin="0,16,0,0">
                    <TextBlock Text="{Binding SetupMessage}" Foreground="#888888" FontSize="12" HorizontalAlignment="Center"/>
                    <ProgressBar Height="3" Margin="0,8,0,0" Minimum="0" Maximum="1" Value="{Binding SetupProgress}" Background="#11FFFFFF" Foreground="White"/>
                    <TextBlock Text="{Binding SetupError}" Foreground="#F87171" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>

            </StackPanel>
        </Grid>

        <!-- ================= MAIN CHAT AREA ================= -->
        <Border CornerRadius="12" BorderBrush="#11FFFFFF" BorderThickness="1" Background="#050505" Visibility="{Binding IsChatVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding SidebarWidth}"/>
                <ColumnDefinition Width="*" MinWidth="620"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="{Binding CanvasWidth, Mode=TwoWay}" MinWidth="360" MaxWidth="900"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="#CC000000" BorderBrush="#0FFFFFFF" BorderThickness="0,0,1,0" CornerRadius="12,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Command="{Binding ToggleSidebarCommand}"
                                Width="32" Height="28"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#888888"
                                Cursor="Hand">
                            <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                        </Button>
                    </Grid>

                    <!-- New Chat Button -->
                    <Border Grid.Row="1" Margin="12,0,12,12" Background="#0AFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8" Cursor="Hand" WindowChrome.IsHitTestVisibleInChrome="True"
                            Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding NewChatCommand}" />
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8">
                            <TextBlock Text="+" Foreground="White" FontSize="15" FontWeight="Medium" Margin="0,-1,8,0"/>
                            <TextBlock Text="New chat" Foreground="White" FontSize="13" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Margin="10,0,10,12" Background="#0AFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8" Cursor="Hand" WindowChrome.IsHitTestVisibleInChrome="True"
                            Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding NewChatCommand}" />
                        </Border.InputBindings>
                        <TextBlock Text="+" Foreground="White" FontSize="18" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,8"/>
                    </Border>

                    <!-- Conversations -->
                    <ListBox Grid.Row="2" Background="Transparent" BorderThickness="0" Foreground="#D0D0D0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" WindowChrome.IsHitTestVisibleInChrome="True"
                             Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
                             ItemsSource="{Binding Conversations}" SelectedItem="{Binding ActiveConversation}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border CornerRadius="8" Padding="12,8" Margin="8,2" Background="Transparent" x:Name="Bd">
                                                <Grid>
                                                    <ContentPresenter/>
                                                    <!-- Delete Button -->
                                                    <Button x:Name="DeleteBtn" Content="✕" Background="Transparent" Foreground="#888" BorderThickness="0" 
                                                            HorizontalAlignment="Right" VerticalAlignment="Center" Width="20" Height="20"
                                                            Visibility="Hidden" Command="{Binding DataContext.DeleteConversationCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#08FFFFFF"/>
                                                    <Setter TargetName="DeleteBtn" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#11FFFFFF"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="13"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ListBox Grid.Row="2"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             WindowChrome.IsHitTestVisibleInChrome="True"
                             Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BooleanToVisibilityConverter}}"
                             ItemsSource="{Binding Conversations}"
                             SelectedItem="{Binding ActiveConversation}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="8,4"/>
                                <Setter Property="ToolTip" Value="{Binding Title}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Width="36" Height="36" CornerRadius="10" Background="Transparent">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#0DFFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ShortTitleIcon}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Footer -->
                    <Border Grid.Row="3" BorderBrush="#0FFFFFFF" BorderThickness="0,1,0,0" Padding="12">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left"
                                        Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Ellipse Width="6" Height="6" Fill="#34D399" Margin="0,0,6,0"/>
                                <TextBlock Text="Running locally" Foreground="#888888" FontSize="11"/>
                            </StackPanel>
                            <Button Command="{Binding ToggleSettingsCommand}"
                                    HorizontalAlignment="Right"
                                    Width="28" Height="28"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#888888"
                                    Cursor="Hand"
                                    ToolTip="Settings">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="2"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ShowsPreview="True"
                          ResizeBehavior="PreviousAndNext"
                          Visibility="{Binding IsCanvasOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- Main Chat Area -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <!-- We add padding on the right to reserve space for Window Controls if Canvas is closed -->
                <Border Grid.Row="0" BorderBrush="#0FFFFFFF" BorderThickness="0,0,0,1" Padding="0,0,150,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Model Selector -->
                        <Border Grid.Column="0" HorizontalAlignment="Left" Margin="16,0,0,0" VerticalAlignment="Center" Cursor="Hand" WindowChrome.IsHitTestVisibleInChrome="True">
                            <ComboBox ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding SelectedModel}" 
                                      Background="Transparent" BorderThickness="0" Foreground="#888888" FontSize="11.5"
                                      DisplayMemberPath="Label" MinWidth="120">
                                <ComboBox.Template>
                                    <ControlTemplate TargetType="ComboBox">
                                        <Grid>
                                            <ToggleButton x:Name="ToggleButton" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="#11FFFFFF" CornerRadius="6" Padding="12,6">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" Fill="#34D399" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <!-- Since DisplayMemberPath is set, SelectionBoxItem might be the whole object, but WPF handles it -->
                                                    <TextBlock Text="{Binding SelectedModel.Label}" Foreground="#888888" FontSize="11.5" VerticalAlignment="Center"/>
                                                    <TextBlock Text="▼" FontSize="8" Foreground="#555" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                </StackPanel>
                                            </ToggleButton>
                                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                                <Border Background="#1A1A1A" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="8" Margin="0,6,0,0" Padding="4">
                                                    <ScrollViewer SnapsToDevicePixels="True">
                                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                                    </ScrollViewer>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                    </ControlTemplate>
                                </ComboBox.Template>
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Padding" Value="12,8"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ComboBoxItem">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsHighlighted" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                        </Border>

                        <!-- Mode Pill -->
                        <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#0AFFFFFF" CornerRadius="8" WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal">
                                <Border CornerRadius="6" Margin="2" Cursor="Hand" x:Name="ChatPill">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveMode}" Value="chat">
                                                    <Setter Property="Background" Value="#1AFFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick" Command="{Binding ToggleModeCommand}" />
                                    </Border.InputBindings>
                                    <TextBlock Text="Chat" FontSize="12" FontWeight="Medium" Margin="12,4">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#888888"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveMode}" Value="chat">
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <Border CornerRadius="6" Margin="2" Cursor="Hand" x:Name="BuildPill">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveMode}" Value="code">
                                                    <Setter Property="Background" Value="#1AFFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick" Command="{Binding ToggleModeCommand}" />
                                    </Border.InputBindings>
                                    <TextBlock Text="Build" FontSize="12" FontWeight="Medium" Margin="12,4">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#888888"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveMode}" Value="code">
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Message List / Empty State -->
                <Grid Grid.Row="1" WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Empty State -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Image Source="Assets/gemma-logo.png" Width="80" Height="80" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <TextBlock Text="{Binding EmptyTitle}" Foreground="White" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding EmptySubtitle}" Foreground="#888888" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,40"/>
                        
                        <!-- Cards -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Background="#0AFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="12" Padding="16" Cursor="Hand" MaxWidth="300">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding SetInputTextCommand}" CommandParameter="Act as a world-class Frontend Engineer. Create a flawless, one-file personal portfolio. 1. UI: Strict Dark Mode (#0f172a) with glassmorphism elements. 2. Navigation: Fixed top bar with backdrop-blur. 3. Hero: Large gradient text 'Creative Developer'. 4. Grid: 3 project cards with 'hover:transform: scale(1.05)' and soft shadows. 5. Typography: Use Inter font. Ensure every element is pixel-perfect. Write everything in a single index.html with embedded CSS."/>
                                </Border.InputBindings>
                                <StackPanel>
                                    <TextBlock Text="Mega Portfolio" Foreground="White" FontWeight="Medium" FontSize="14"/>
                                    <TextBlock Text="Detailed instructions for a pixel-perfect, glassmorphic developer site." Foreground="#888888" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="2" Background="#0AFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="12" Padding="16" Cursor="Hand" MaxWidth="300">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding SetInputTextCommand}" CommandParameter="Create a stunning 'Dynamic Weather Dashboard' in a single index.html. 1. UI: Glassmorphism cards with a blurred background that changes based on weather (sunny, rainy, snowy). 2. Features: A large current temperature display, a 5-day forecast grid, and animated SVG weather icons. 3. Interactivity: Use smooth CSS transitions and a clean, high-end typography (Inter font). Ensure the design looks like a premium weather app."/>
                                </Border.InputBindings>
                                <StackPanel>
                                    <TextBlock Text="Weather Dashboard" Foreground="White" FontWeight="Medium" FontSize="14"/>
                                    <TextBlock Text="A beautiful weather app with dynamic backgrounds and glassmorphism." Foreground="#888888" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="0" Background="#0AFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="12" Padding="16" Cursor="Hand" MaxWidth="300">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding SetInputTextCommand}" CommandParameter="Create a high-performance Tetris game in ONE index.html file. Requirements: 1. A 10x20 grid with a 'Next Piece' preview window. 2. Control: Move with Left/Right, Soft Drop with Down, Instant Drop with Space. 3. ROTATION: Essential - rotate pieces using the 'Up' arrow or 'W' key. 4. Visuals: Glowing neon blocks with particle effects when a line is cleared. 5. Scoring: Level up system and high-score persistence. Flawless collision and rotation logic is mandatory."/>
                                </Border.InputBindings>
                                <StackPanel>
                                    <TextBlock Text="Mega Tetris" Foreground="White" FontWeight="Medium" FontSize="14"/>
                                    <TextBlock Text="A classic Tetris clone with neon blocks, levels, and perfect rotation logic." Foreground="#888888" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="2" Background="#0AFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="12" Padding="16" Cursor="Hand" MaxWidth="300">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding SetInputTextCommand}" CommandParameter="Design a premium, Apple-style 'Scientific Calculator' in a single index.html. 1. UI: A sleek dark glassmorphism design with rounded buttons. 2. Functionality: Support basic math, percentages, and scientific functions (sin, cos, log). 3. Features: Responsive layout, history of previous calculations, and smooth animations when clicking buttons. Use a large, clean font for the display."/>
                                </Border.InputBindings>
                                <StackPanel>
                                    <TextBlock Text="Premium Calculator" Foreground="White" FontWeight="Medium" FontSize="14"/>
                                    <TextBlock Text="A high-end scientific calculator with glassmorphism and smooth animations." Foreground="#888888" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" 
                                  PanningMode="VerticalOnly" CanContentScroll="False"
                                  Visibility="{Binding IsEmpty, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                  WindowChrome.IsHitTestVisibleInChrome="True">
                        <ItemsControl ItemsSource="{Binding Messages}" Margin="24,24,24,24" MaxWidth="768" HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewmodels:ChatMessage}">
                                    <Grid Margin="0,8">
                                        <!-- User message -->
                                        <Border Background="#14FFFFFF" CornerRadius="16,16,4,16" Padding="16,10" 
                                                HorizontalAlignment="Right" MaxWidth="550"
                                                Visibility="{Binding IsUser, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="White" FontSize="14.5" LineHeight="22"/>
                                        </Border>
                                        
                                        <!-- Assistant message -->
                                        <Grid HorizontalAlignment="Left"
                                              Visibility="{Binding IsUser, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Grid.Column="0" Source="Assets/gemma-logo.png" Width="28" Height="28" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                            <StackPanel Grid.Column="1">
                                                <ItemsControl ItemsSource="{Binding ToolCards}" Margin="0,0,0,8">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type viewmodels:AssistantToolCard}">
                                                            <Expander IsExpanded="{Binding IsOpen, Mode=TwoWay}" Margin="0,0,0,10">
                                                                <Expander.Template>
                                                                    <ControlTemplate TargetType="Expander">
                                                                        <Border x:Name="Card" Background="#08FFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1" CornerRadius="8">
                                                                            <Grid>
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="Auto"/>
                                                                                    <RowDefinition Height="Auto"/>
                                                                                </Grid.RowDefinitions>

                                                                                <ToggleButton Grid.Row="0" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                                                              Background="Transparent" BorderThickness="0" Padding="14,10" Cursor="Hand">
                                                                                    <ToggleButton.Template>
                                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                                            <Border Background="Transparent">
                                                                                                <Grid>
                                                                                                    <Grid.ColumnDefinitions>
                                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                                        <ColumnDefinition Width="*"/>
                                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                                    </Grid.ColumnDefinitions>
                                                                                                    <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#34D399" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                                                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="#E8E8E8" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                                                    <TextBlock Grid.Column="2" Text="{Binding Target}" Foreground="#888888" FontFamily="Consolas" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                                                    <TextBlock Grid.Column="3" Text="›" Foreground="#888888" FontSize="16" VerticalAlignment="Center">
                                                                                                        <TextBlock.Style>
                                                                                                            <Style TargetType="TextBlock">
                                                                                                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                                                                                                <Setter Property="RenderTransform">
                                                                                                                    <Setter.Value>
                                                                                                                        <RotateTransform Angle="0"/>
                                                                                                                    </Setter.Value>
                                                                                                                </Setter>
                                                                                                                <Style.Triggers>
                                                                                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                                                                                        <Setter Property="RenderTransform">
                                                                                                                            <Setter.Value>
                                                                                                                                <RotateTransform Angle="90"/>
                                                                                                                            </Setter.Value>
                                                                                                                        </Setter>
                                                                                                                    </DataTrigger>
                                                                                                                </Style.Triggers>
                                                                                                            </Style>
                                                                                                        </TextBlock.Style>
                                                                                                    </TextBlock>
                                                                                                </Grid>
                                                                                            </Border>
                                                                                        </ControlTemplate>
                                                                                    </ToggleButton.Template>
                                                                                </ToggleButton>

                                                                                <ContentPresenter x:Name="ExpandSite" Grid.Row="1" Visibility="Collapsed"/>
                                                                            </Grid>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsExpanded" Value="True">
                                                                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Expander.Template>

                                                                <Border BorderBrush="#0DFFFFFF" BorderThickness="0,1,0,0" Padding="14,12">
                                                                    <StackPanel>
                                                                        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                                                            <TextBlock Text="{Binding Content}" FontFamily="Consolas" FontSize="12.5" Foreground="#D6D6D6" TextWrapping="NoWrap" LineHeight="19"/>
                                                                        </ScrollViewer>
                                                                        <TextBlock Text="{Binding Result}" Foreground="#A8A8A8" FontFamily="Consolas" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </Expander>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <markdig:MarkdownViewer Markdown="{Binding Content}" Foreground="#E8E8E8" Background="Transparent" Margin="0" FontSize="14.5">
                                                    <markdig:MarkdownViewer.Resources>
                                                        <Style TargetType="{x:Type Paragraph}">
                                                            <Setter Property="Margin" Value="0,4,0,12" />
                                                        </Style>
                                                        <Style x:Key="{x:Static markdig:Styles.CodeBlockStyleKey}" TargetType="{x:Type Paragraph}">
                                                            <Setter Property="Background" Value="#80000000" />
                                                            <Setter Property="Foreground" Value="#D1D1D1" />
                                                            <Setter Property="FontFamily" Value="Consolas, monospace" />
                                                            <Setter Property="FontSize" Value="12.5" />
                                                            <Setter Property="Padding" Value="14" />
                                                            <Setter Property="Margin" Value="0,8,0,12" />
                                                        </Style>
                                                        <Style x:Key="{x:Static markdig:Styles.CodeStyleKey}" TargetType="{x:Type Run}">
                                                            <Setter Property="Background" Value="#12FFFFFF" />
                                                            <Setter Property="FontFamily" Value="Consolas, monospace" />
                                                            <Setter Property="FontSize" Value="12.5" />
                                                        </Style>
                                                        <Style TargetType="{x:Type List}">
                                                            <Setter Property="Margin" Value="20,0,0,12" />
                                                        </Style>
                                                    </markdig:MarkdownViewer.Resources>
                                                </markdig:MarkdownViewer>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Button Content="↻ Regenerate" Command="{Binding DataContext.RegenerateMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#888" BorderThickness="0" FontSize="11" Padding="6,2" Cursor="Hand" Margin="0,0,4,0"/>
                                                    <Button Content="Copy" Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#888" BorderThickness="0" FontSize="11" Padding="6,2" Cursor="Hand"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Composer -->
                <StackPanel Grid.Row="2" MaxWidth="800" Margin="24,0,24,18" HorizontalAlignment="Stretch" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border Background="#0F0F0F" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="18" Padding="14,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox x:Name="InputBox" Grid.Row="0" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" 
                                     AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="180" MinHeight="44"
                                     Background="Transparent" BorderThickness="0" Foreground="White" FontSize="14.5" 
                                     CaretBrush="White" Padding="4,2" VerticalContentAlignment="Top"/>

                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="1">
                                    <Border Background="White" CornerRadius="17" Height="34" Width="34" Cursor="Hand"
                                            Visibility="{Binding IsGenerating, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftClick" Command="{Binding SendMessageCommand}" />
                                        </Border.InputBindings>
                                        <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <Border Background="#333" CornerRadius="17" Height="34" Width="34" Cursor="Hand"
                                            Visibility="{Binding IsGenerating, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftClick" Command="{Binding StopGenerationCommand}" />
                                        </Border.InputBindings>
                                        <Border Background="White" Width="10" Height="10" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                    <TextBlock Text="Enter to send - Shift+Enter for newline" Foreground="#666666" FontSize="11" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>
            
            <!-- ================= CANVAS (WORKSPACE) ================= -->
            <Border Grid.Column="3" BorderBrush="#0FFFFFFF" BorderThickness="1,0,0,0" Background="#0A0A0A"
                    CornerRadius="0,12,12,0" ClipToBounds="True"
                    Visibility="{Binding IsCanvasOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
	                <Grid>
	                    <Grid.RowDefinitions>
	                        <RowDefinition Height="72"/>
	                        <RowDefinition Height="*"/>
	                    </Grid.RowDefinitions>

                    <!-- Canvas Header (Tabs) -->
                    <!-- We add padding 12,0 and reserve the 150px via Grid column for Window Controls -->
	                    <Border Grid.Row="0" Height="44" VerticalAlignment="Bottom" BorderBrush="#0FFFFFFF" BorderThickness="0,0,0,1" Padding="16,0,12,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#0AFFFFFF" CornerRadius="6" Padding="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border CornerRadius="4" Padding="10,5" Cursor="Hand">
                                        <Border.InputBindings><MouseBinding Gesture="LeftClick" Command="{Binding SetCanvasTabCommand}" CommandParameter="preview"/></Border.InputBindings>
                                        <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding ActiveCanvasTab}" Value="preview"><Setter Property="Background" Value="#1AFFFFFF"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                        <TextBlock Text="Preview" FontSize="11.5" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#888888"/><Style.Triggers><DataTrigger Binding="{Binding ActiveCanvasTab}" Value="preview"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                    </Border>
                                    <Border CornerRadius="4" Padding="10,5" Cursor="Hand">
                                        <Border.InputBindings><MouseBinding Gesture="LeftClick" Command="{Binding SetCanvasTabCommand}" CommandParameter="code"/></Border.InputBindings>
                                        <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding ActiveCanvasTab}" Value="code"><Setter Property="Background" Value="#1AFFFFFF"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                        <TextBlock Text="Code" FontSize="11.5" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#888888"/><Style.Triggers><DataTrigger Binding="{Binding ActiveCanvasTab}" Value="code"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                    </Border>
                                    <Border CornerRadius="4" Padding="10,5" Cursor="Hand">
                                        <Border.InputBindings><MouseBinding Gesture="LeftClick" Command="{Binding SetCanvasTabCommand}" CommandParameter="files"/></Border.InputBindings>
                                        <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding ActiveCanvasTab}" Value="files"><Setter Property="Background" Value="#1AFFFFFF"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                        <TextBlock Text="{Binding WorkspaceFileCountText}" FontSize="11.5" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#888888"/><Style.Triggers><DataTrigger Binding="{Binding ActiveCanvasTab}" Value="files"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsGenerating, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,12,0">
                                    <Ellipse Width="6" Height="6" Fill="#34D399" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Building..." Foreground="#888888" FontSize="11.5" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Background="Transparent" CornerRadius="4" Width="28" Height="28" Cursor="Hand" Margin="2,0" ToolTip="Refresh preview" WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Border.InputBindings><MouseBinding Gesture="LeftClick" Command="{Binding RefreshPreviewCommand}"/></Border.InputBindings>
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#888" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Background="Transparent" CornerRadius="4" Width="28" Height="28" Cursor="Hand" Margin="2,0" ToolTip="View Full Screen (Browser)" WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Border.InputBindings><MouseBinding Gesture="LeftClick" Command="{Binding OpenInBrowserCommand}"/></Border.InputBindings>
                                    <TextBlock Text="&#xE744;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#888" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Background="Transparent" CornerRadius="4" Width="28" Height="28" Cursor="Hand" Margin="2,0" ToolTip="Open workspace folder" WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Border.InputBindings><MouseBinding Gesture="LeftClick" Command="{Binding OpenWorkspaceFolderCommand}"/></Border.InputBindings>
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#888" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Background="Transparent" CornerRadius="4" Width="28" Height="28" Cursor="Hand" Margin="2,0" ToolTip="Close canvas" WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Border.InputBindings><MouseBinding Gesture="LeftClick" Command="{Binding ToggleCanvasCommand}"/></Border.InputBindings>
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#888" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Canvas Body -->
                    <Border Grid.Row="1" CornerRadius="0,0,12,0">
                        <Grid>
                            <!-- Preview Tab -->
                            <Grid Background="White" Visibility="{Binding ActiveCanvasTab, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=preview}">
                                <wv2:WebView2 x:Name="PreviewWebView" DefaultBackgroundColor="White" />
                            </Grid>
                            
                            <!-- Code Tab -->
                            <Grid Visibility="{Binding ActiveCanvasTab, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=code}" Background="#0A0A0A">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Code Header -->
                                <Border Grid.Row="0" BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1" Padding="16,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="#34D399" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding CurrentFileName}" Foreground="#E8E8E8" FontFamily="Consolas" FontSize="11.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="{Binding CurrentLineCount}" Foreground="#888888" FontSize="11.5"/>
                                            <TextBlock Text=" lines · " Foreground="#888888" FontSize="11.5"/>
                                            <TextBlock Text="{Binding CurrentCharCount}" Foreground="#888888" FontSize="11.5"/>
                                            <TextBlock Text=" chars" Foreground="#888888" FontSize="11.5"/>
                                            <TextBlock Text=" writing" Foreground="#888888" FontSize="11.5" Margin="8,0,0,0" Visibility="{Binding IsGenerating, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Code Content -->
                                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Line Numbers -->
                                        <Border Grid.Column="0" BorderBrush="#0AFFFFFF" BorderThickness="0,0,1,0" Background="#0A0A0A" Padding="12">
                                            <TextBlock Text="{Binding LineNumbers}" Foreground="#555555" FontFamily="Consolas" FontSize="12" TextAlignment="Right" LineHeight="18.6" LineStackingStrategy="BlockLineHeight"/>
                                        </Border>
                                        
                                        <!-- Code -->
                                        <Border Grid.Column="1" Padding="16,12">
                                            <TextBlock Text="{Binding CurrentCode}" Foreground="#E8E8E8" FontFamily="Consolas" FontSize="12" LineHeight="18.6" LineStackingStrategy="BlockLineHeight" TextWrapping="NoWrap"/>
                                        </Border>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>

                            <!-- Files Tab -->
                            <Grid Visibility="{Binding ActiveCanvasTab, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=files}" Background="#0A0A0A">
                                <ListBox ItemsSource="{Binding WorkspaceFiles}" SelectedItem="{Binding SelectedFile}" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="12,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📄 " Foreground="#555" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding Name}" Foreground="#CCC"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            </Grid>
        </Border>

        <!-- Global Window Controls -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True" Panel.ZIndex="9999" Margin="0,6,8,0">
            <Button Content="—" Width="42" Height="32" Background="Transparent" Foreground="#888888" BorderThickness="0" Click="OnMinimizeClick"/>
            <Button Content="☐" Width="42" Height="32" Background="Transparent" Foreground="#888888" BorderThickness="0" Click="OnMaximizeClick"/>
            <Button Content="✕" Width="42" Height="32" Background="Transparent" Foreground="#888888" BorderThickness="0" Click="OnCloseClick"/>
        </StackPanel>

        <!-- Settings Panel -->
        <Grid Panel.ZIndex="9000" Background="#99000000" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BooleanToVisibilityConverter}}" WindowChrome.IsHitTestVisibleInChrome="True">
            <Border Width="440" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="64,56,0,56"
                    Background="#101010" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Settings" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                        <Button Grid.Column="1" Command="{Binding CloseSettingsCommand}" Width="32" Height="32" Background="Transparent" BorderThickness="0" Foreground="#888" Cursor="Hand">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Generation" Foreground="#888888" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="Temperature" Foreground="#DDDDDD" FontSize="13" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="54"/>
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="0" Maximum="1.5" TickFrequency="0.1" Value="{Binding Temperature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Temperature, StringFormat=F1}" Foreground="#AAAAAA" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Text="GPU layers (0 = auto)" Foreground="#DDDDDD" FontSize="13" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding GpuLayers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="#0AFFFFFF" Foreground="White" BorderBrush="#22FFFFFF" BorderThickness="1" Padding="10,7" Margin="0,0,0,16"/>

                            <CheckBox IsChecked="{Binding AutoOpenPreview, Mode=TwoWay}" Foreground="#DDDDDD" Margin="0,0,0,18">
                                <TextBlock Text="Switch back to Preview after code is written"/>
                            </CheckBox>

                            <TextBlock Text="Custom system instructions" Foreground="#DDDDDD" FontSize="13" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding CustomSystemPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="130"
                                     Background="#0AFFFFFF" Foreground="White" BorderBrush="#22FFFFFF" BorderThickness="1" Padding="10"
                                     VerticalScrollBarVisibility="Auto"/>

                            <TextBlock Text="Shortcuts" Foreground="#888888" FontSize="11" FontWeight="SemiBold" Margin="0,22,0,8"/>
                            <TextBlock Text="Ctrl+N new chat&#x0a;Ctrl+B Chat/Build&#x0a;Ctrl+\ toggle Canvas&#x0a;Ctrl+E export project" Foreground="#AAAAAA" FontSize="12" LineHeight="20"/>
                        </StackPanel>
                    </ScrollViewer>

                    <TextBlock Grid.Row="2" Text="Settings are saved automatically." Foreground="#666666" FontSize="11" Margin="0,14,0,0"/>
                </Grid>
            </Border>
        </Grid>


        </Grid>
    </Border>
</Window>
